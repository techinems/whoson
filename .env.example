# Base URL of the RPI Ambulance crew-schedule web endpoint this app proxies.
BASE_URL=https://example.rpiambulance.com/whoson
# Token the upstream web endpoint expects (sent as ?token=...).
RPIA_WEB_TOKEN=superlongtokenhere
# Slack app Signing Secret (Slack app settings -> Basic Information -> App
# Credentials). Used to verify inbound requests via HMAC. This REPLACES the old
# deprecated verification token (SLACK_SIGNING_TOKEN).
SLACK_SIGNING_SECRET=slack-signing-secret-here
# Optional: port to listen on (defaults to 3000).
NODE_PORT=3000
TZ=America/New_York
